      ],
      "source": [
        "# CASE-BASED LEARNING\n",
        "\n",
        "# Previous cases\n",
        "cases = [\n",
        "    {\"hours\": 2, \"mark\": 45},\n",
        "    {\"hours\": 4, \"mark\": 60},\n",
        "    {\"hours\": 6, \"mark\": 75},\n",
        "    {\"hours\": 8, \"mark\": 88}\n",
        "]\n",
        "\n",
        "# New student\n",
        "new_hours = 5.5\n",
        "\n",
        "# Find the most similar previous case\n",
        "best_case = None\n",
        "smallest_distance = float(\"inf\")\n",
        "\n",
        "for case in cases:\n",
        "\n",
        "    distance = abs(case[\"hours\"] - new_hours)\n",
        "\n",
        "    print(\n",
        "        \"Previous Case:\",\n",
        "        case[\"hours\"],\n",
        "        \"hours | Distance:\",\n",
        "        distance\n",
        "    )\n",
        "\n",
        "    if distance < smallest_distance:\n",
        "        smallest_distance = distance\n",
        "        best_case = case\n",
        "\n",
        "print(\"\\nNew Student:\", new_hours, \"hours\")\n",
        "\n",
        "print(\n",
        "    \"Most Similar Previous Case:\",\n",
        "    best_case[\"hours\"],\n",
        "    \"hours\"\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"Previous Student Mark:\",\n",
        "    best_case[\"mark\"]\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"Suggested Predicted Mark:\",\n",
        "    best_case[\"mark\"]\n",
        ")"
      ]
    }
  ]
